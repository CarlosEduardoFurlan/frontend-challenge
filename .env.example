# Base URL used by the Axios client. The mock layer intercepts this origin.
VITE_API_URL=/api

# Socket.IO endpoint. With mocks enabled, MSW intercepts this WebSocket URL.
VITE_SOCKET_URL=/

# Enables the MSW network layer (REST + Socket.IO). Keep "true" for the demo build.
VITE_ENABLE_MOCKS=true

# Default mock scenario when none is selected via URL or local storage.
VITE_MOCK_SCENARIO=default
